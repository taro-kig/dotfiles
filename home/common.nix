{
  config,
  lib,
  pkgs,
  user,
  ...
}:
{
  home.stateVersion = "26.05";

  programs.home-manager.enable = true;

  home.packages = with pkgs; [
    aqua
    fd
    jq
    ripgrep
    tmux
    tree
  ];

  # Shims for project-local CLIs managed by aqua (aqua.yaml).
  home.sessionPath = [ "$HOME/.local/share/aquaproj-aqua/bin" ];

  programs.git = {
    enable = true;
    settings = {
      user = {
        name = user.gitName;
        email = user.gitEmail;
      };
      init.defaultBranch = "main";
      pull.rebase = true;
    };
  };

  programs.zsh = {
    enable = true;
    enableCompletion = true;
    autosuggestion.enable = true;
    syntaxHighlighting.enable = true;
    history = {
      size = 100000;
      ignoreDups = true;
      share = true;
    };
    shellAliases = {
      ll = "eza -l --git";
      la = "eza -la --git";
      cat = "bat --paging=never";
    };
  };

  programs.neovim = {
    enable = true;
    defaultEditor = true;
    viAlias = true;
    vimAlias = true;
    # Needed by treesitter parser builds and coc.nvim.
    extraPackages = with pkgs; [
      gcc
      nodejs
      tree-sitter
    ];
  };

  # Linked out of the store so lazy.nvim can update lazy-lock.json. The
  # init.lua generated by programs.neovim would otherwise collide with the link.
  xdg.configFile."nvim".source =
    config.lib.file.mkOutOfStoreSymlink "${config.home.homeDirectory}/dotfiles/nvim";
  xdg.configFile."nvim/init.lua".enable = lib.mkForce false;

  xdg.configFile."tmux/tmux.conf".source = ../tmux/tmux.conf;

  programs.bat.enable = true;
  programs.eza.enable = true;
  programs.fzf.enable = true;
  programs.starship.enable = true;
  programs.zoxide.enable = true;

  programs.direnv = {
    enable = true;
    nix-direnv.enable = true;
  };
}
